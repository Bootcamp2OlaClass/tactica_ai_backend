# Local development values only. Replace these outside local development.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tactica_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tactica_db

LOG_LEVEL=INFO
LOG_DIR=logs
APP_LOG_FILE=app.log
ERROR_LOG_FILE=error.log
ENABLE_CONSOLE_LOG=true

JWT_SECRET=replace-with-a-random-local-secret

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth hardening (Phase 02) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Marks the refresh-token cookie Secure. Must be true in any real (https)
# deployment; only set to false for local http development.
COOKIE_SECURE=true

# --- Document storage (Phase 03) ---
# "local" (default) writes to UPLOAD_DIR on disk — fine for dev, does not
# survive a redeploy on an ephemeral host. "r2" requires the four R2_*
# variables below (never commit real values).
STORAGE_PROVIDER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Optional — defaults to https://{R2_ACCOUNT_ID}.r2.cloudflarestorage.com
R2_ENDPOINT_URL=

# --- Background jobs (Phase 04, ADR-005) ---
# Redis backs both the Celery broker and result backend by default; override
# CELERY_BROKER_URL/CELERY_RESULT_BACKEND independently if you ever need
# them split (e.g. different Redis DB indices or instances).
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# --- LLM provider (Phase 06 structured extraction, ADR-002; Phase 07
# embeddings, ADR-007; Phase 08 AI Study Coach) ---
# Unset (default) disables every AI feature (extraction/embedding/chat) --
# they fail with a clear "not configured" error rather than at app boot.
# "gemini" requires GEMINI_API_KEY; "openai" requires OPENAI_API_KEY. One
# vendor selection governs generation AND embeddings (ADR-007) -- there is
# no separate EMBEDDING_PROVIDER setting.
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small