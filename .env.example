# Local development values only. Replace these outside local development.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=tactica_db
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/tactica_db

LOG_LEVEL=INFO
LOG_DIR=logs
APP_LOG_FILE=app.log
ERROR_LOG_FILE=error.log
ENABLE_CONSOLE_LOG=true

JWT_SECRET=replace-with-a-random-local-secret

# Comma-separated list of origins allowed to call this API from a browser.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Auth hardening (Phase 02) ---
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_HOURS=24
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Marks the refresh-token cookie Secure. Must be true in any real (https)
# deployment; only set to false for local http development.
COOKIE_SECURE=true